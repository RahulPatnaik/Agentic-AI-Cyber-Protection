# Mistral AI Configuration
MISTRAL_API_KEY=your-mistral-api-key-here

# Network Configuration
NETWORK_INTERFACE=wlan0
PROMISCUOUS_MODE=true
ENABLE_LIVE_CAPTURE=true

# ML Configuration
ML_MODELS_PATH=data/models
ML_CONFIDENCE_THRESHOLD=0.85

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///wifi_guardian.db

# Message Queue Configuration (use in-memory queue for MVP)
USE_IN_MEMORY_QUEUE=true
RABBITMQ_URL=amqp://localhost:5672

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENABLE_WEBSOCKET=true

# Caching Configuration
MISTRAL_CACHE_TTL=3600
ENABLE_RESPONSE_CACHE=true

# Security Configuration
WHITELISTED_DEVICES=
MAX_ACTIONS_PER_MINUTE=10
REQUIRE_APPROVAL_FOR_CRITICAL=true

# Logging Configuration
LOG_LEVEL=INFO
ENABLE_LOGFIRE=false
AUDIT_LOG_PATH=logs/audit.log

# MITRE ATT&CK
MITRE_DATA_PATH=data/threat_intel/mitre_attack.json
